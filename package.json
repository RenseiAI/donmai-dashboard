{
  "name": "agent-fleet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "worker": "af-worker",
    "orchestrator": "af-orchestrator",
    "worker-fleet": "af-worker-fleet",
    "cleanup": "af-cleanup",
    "queue-admin": "af-queue-admin",
    "analyze-logs": "af-analyze-logs",
    "governor": "af-governor",
    "governor:once": "af-governor --once",
    "sync-routes": "af-sync-routes",
    "sync-routes:dry": "af-sync-routes --dry-run",
    "sync-routes:pages": "af-sync-routes --pages",
    "bump:af": "pnpm update @supaku/agentfactory @supaku/agentfactory-cli @supaku/agentfactory-dashboard @supaku/agentfactory-linear @supaku/agentfactory-nextjs @supaku/agentfactory-server --latest",
    "prepare": "dotenvx ext precommit --install"
  },
  "dependencies": {
    "@supaku/agentfactory": "^0.7.50",
    "@supaku/agentfactory-cli": "^0.7.50",
    "@supaku/agentfactory-dashboard": "^0.7.50",
    "@supaku/agentfactory-linear": "^0.7.50",
    "@supaku/agentfactory-nextjs": "^0.7.50",
    "@supaku/agentfactory-server": "^0.7.50",
    "ioredis": "^5.4.1",
    "next": "16.1.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.52.0",
    "@next/eslint-plugin-next": "^16.1.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "ioredis-mock": "^8.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.48.1",
    "vitest": "^3.2.3"
  }
