# Linear OAuth App Credentials
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Linear Webhook Verification
LINEAR_WEBHOOK_SECRET=

# Linear API Access (for SDK operations and CLI)
LINEAR_ACCESS_TOKEN=
LINEAR_API_KEY=

# App URL (for OAuth redirect)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Redis (for token/session storage and webhook idempotency)
# Format: redis://[:password@]host[:port][/db]
# For Upstash/Vercel Redis: rediss://default:password@host:port
# NOTE: This is a dedicated OSS Redis instance — do NOT share with the platform Redis.
REDIS_URL=

# Donmai API URL (donmai-dashboard endpoint; was WORKER_API_URL pointing at agent.rensei.dev)
# During transition: agent.rensei.dev 301-redirects to donmai.dev/dashboard
# Wave 5: update to https://donmai.dev/dashboard once redirect is live
DONMAI_API_URL=https://donmai.dev/dashboard

# Worker Client Configuration (legacy name; DONMAI_API_URL is the canonical name)
WORKER_API_URL=https://agent.rensei.dev
WORKER_API_KEY=

# Agent Provider (default: claude)
# Options: claude, codex, amp
# AGENT_PROVIDER=claude

# Auto-Trigger Configuration
# Enable automatic QA when issues move to Finished status
ENABLE_AUTO_QA=false
# Enable automatic acceptance when issues move to Delivered status
ENABLE_AUTO_ACCEPTANCE=false

# Require agent to have worked on the issue before auto-triggering
# Set to false to auto-trigger for ALL issues (not just agent-worked ones)
AUTO_QA_REQUIRE_AGENT_WORKED=true
AUTO_ACCEPTANCE_REQUIRE_AGENT_WORKED=true

# Restrict auto-triggers to specific projects (comma-separated)
# Leave empty to allow all projects
AUTO_QA_PROJECTS=
AUTO_ACCEPTANCE_PROJECTS=

# Exclude issues with these labels from auto-triggers (comma-separated)
AUTO_QA_EXCLUDE_LABELS=
AUTO_ACCEPTANCE_EXCLUDE_LABELS=

# Governor Configuration
# Mode: direct (webhooks dispatch directly), event-bridge (dual-write), governor-only (events only)
GOVERNOR_MODE=direct
# Projects to scan (comma-separated) — should include ALL projects across worker pools
GOVERNOR_PROJECTS=Agent, Agent Fleet, Social, Family, Art, Account, Marketing
# Poll sweep interval for event-driven mode safety net (default: 300000 = 5 min)
GOVERNOR_POLL_INTERVAL_MS=300000

# Worker fleet
WORKER_POLL_INTERVAL=2000
WORKER_HEARTBEAT_INTERVAL=15000
WORKER_TTL=120
WORKER_FLEET_SIZE=5
WORKER_CAPACITY=1
WORKER_PROJECTS=

# Session logging
AGENT_SESSION_LOGGING_ENABLED=true
AGENT_AUTO_ANALYZE_ENABLED=true
